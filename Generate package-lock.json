
name: Generate package-lock.json

on:
  workflow_dispatch:

permissions:
  contents: write

jobs:
  generate-lockfile:
    runs-on: ubuntu-latest

    steps:
      - name: Checkout repository
        uses: actions/checkout@v4

      - name: Set up Node.js
        uses: actions/setup-node@v4
        with:
          node-version: 22

      - name: Verify package.json
        run: test -s package.json

      - name: Generate package-lock.json
        run: npm install --package-lock-only --ignore-scripts --no-audit --no-fund

      - name: Verify and commit lock file
        run: |
          test -s package-lock.json
          node -e "const p=require('./package-lock.json'); if(p.name!=='shruti-vedic-video-studio'||!p.packages||!p.packages['']) process.exit(1); console.log('Lock file structure verified.')"

          git config user.name "github-actions[bot]"
          git config user.email "41898282+github-actions[bot]@users.noreply.github.com"

          git add package-lock.json

          if git diff --cached --quiet; then
            echo "No lock-file changes to commit."
            exit 0
          fi

          git commit -m "Add valid package-lock.json"
          git push origin HEAD:main
